diff --git a/src/client/Trainer.ts b/src/client/Trainer.ts
new file mode 100644
index 00000000..d5e7f9d8
--- /dev/null
+++ b/src/client/Trainer.ts
@@ -0,0 +1,296 @@
+// TRAINER.PRO (teamstats.pro/trainer): a modified build of the OpenFront
+// client that skips the menu and starts a 1v1 against one AI nation.
+// The page sets window.__TRAINER__ = { home } before this bundle runs; the
+// match settings come from the URL: ?map=Australia&difficulty=Medium&size=Normal&name=Bembe
+import {
+  Difficulty,
+  GameMapSize,
+  GameMode,
+  GameType,
+  PlayerType,
+} from "@openfront/engine-api/game/GameTypes";
+import { GameMapType } from "@openfront/engine-api/game/Maps.gen";
+import { generateID } from "@openfront/shared/SharedUtil";
+import type { ResolvedPlayerName } from "./PlayerName";
+
+// Read once at load: the client rewrites the address bar during the join.
+const QUERY = new URLSearchParams(
+  typeof window === "undefined" ? "" : window.location.search,
+);
+
+interface TrainerPage {
+  home: string;
+}
+
+function page(): TrainerPage | undefined {
+  return (window as unknown as { __TRAINER__?: TrainerPage }).__TRAINER__;
+}
+
+const TRAINER_BOT_NAME = "Teamstats.PRO";
+
+export function isTrainer(): boolean {
+  return typeof window !== "undefined" && page() !== undefined;
+}
+
+// Games vs our bot are archived on teamstats.pro (admins watch their replays there)
+export const TRAINER_API = "/api/trainer";
+
+/** Land and army of both sides, kept fresh during a game and sent with its record: when
+ * the player leaves before the end, teamstats.pro judges the result from it (HIDDEN ELO). */
+export interface TrainerSnapshot {
+  tick: number;
+  player: { tiles: number; troops: number; alive: boolean };
+  bot: { tiles: number; troops: number; alive: boolean };
+}
+let snapshot: TrainerSnapshot | null = null;
+export function trainerSnapshot(): TrainerSnapshot | null {
+  return snapshot;
+}
+interface SnapshotPlayer {
+  name(): string;
+  type(): PlayerType;
+  numTilesOwned(): number;
+  troops(): number;
+  isAlive(): boolean;
+}
+export function noteTrainerState(game: {
+  ticks(): number;
+  players(): SnapshotPlayer[];
+  inSpawnPhase?(): boolean;
+}): void {
+  if (!isTrainer() || game.ticks() % 20 !== 0) return;
+  const players = game.players();
+  const bot = players.find((p) => p.name() === TRAINER_BOT_NAME);
+  const me = players.find((p) => p.type() === PlayerType.Human);
+  if (bot === undefined || me === undefined) return;
+  const side = (p: SnapshotPlayer) => ({
+    tiles: p.numTilesOwned(),
+    troops: Math.round(p.troops()),
+    alive: p.isAlive(),
+  });
+  snapshot = { tick: game.ticks(), player: side(me), bot: side(bot) };
+  if (game.inSpawnPhase?.() === true || trainerReplaying()) return;
+  if (game.ticks() % 50 === 0) history.push(snapshot);
+  // The game goes on against the map's bots once one of us is gone: we end it here with a
+  // result screen (Bembe, 2026-11-01)
+  if (!ended && (!snapshot.bot.alive || !snapshot.player.alive)) {
+    ended = true;
+    history.push(snapshot);
+    showTrainerEnd(snapshot.player.alive);
+  }
+}
+
+// Land and army of both sides every 5 s of play, for the result screen
+const history: TrainerSnapshot[] = [];
+let ended = false;
+
+const fmt = (n: number) =>
+  n >= 1e6
+    ? (n / 1e6).toFixed(n >= 1e7 ? 0 : 1) + "M"
+    : n >= 1e3
+      ? Math.round(n / 1e3) + "K"
+      : String(Math.round(n));
+const clock = (ticks: number) => {
+  const s = Math.max(0, Math.round(ticks / 10));
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
+};
+
+/** A line chart of you vs the bot, as SVG markup. */
+function chart(
+  title: string,
+  pick: (s: TrainerSnapshot, who: "player" | "bot") => number,
+): string {
+  const W = 320,
+    H = 120,
+    P = 6;
+  const t0 = history[0]?.tick ?? 0,
+    t1 = history[history.length - 1]?.tick ?? 1;
+  const top = Math.max(
+    1,
+    ...history.flatMap((s) => [pick(s, "player"), pick(s, "bot")]),
+  );
+  const line = (who: "player" | "bot") =>
+    history
+      .map((s) => {
+        const x = P + ((s.tick - t0) / Math.max(1, t1 - t0)) * (W - 2 * P);
+        const y = H - P - (pick(s, who) / top) * (H - 2 * P);
+        return `${x.toFixed(1)},${y.toFixed(1)}`;
+      })
+      .join(" ");
+  return `<figure style="margin:0;flex:1 1 300px;min-width:0">
+    <figcaption style="font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#9fb0c8;margin-bottom:6px">${title} <span style="float:right;color:#cfd8e6;letter-spacing:0">max ${fmt(top)}</span></figcaption>
+    <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;background:rgba(255,255,255,.04);border-radius:10px" role="img" aria-label="${title}">
+      <polyline points="${line("bot")}" fill="none" stroke="#ff5fb0" stroke-width="2.5" stroke-linejoin="round"/>
+      <polyline points="${line("player")}" fill="none" stroke="#57e6ff" stroke-width="2.5" stroke-linejoin="round"/>
+    </svg></figure>`;
+}
+
+function showTrainerEnd(won: boolean): void {
+  const last = history[history.length - 1];
+  const t0 = history[0]?.tick ?? last.tick;
+  const peak = (who: "player" | "bot", k: "tiles" | "troops") =>
+    Math.max(0, ...history.map((s) => s[who][k]));
+  // When the lead in land changed hands for the last time
+  let lead: number | null = null;
+  for (let i = 1; i < history.length; i++) {
+    const a = history[i - 1],
+      b = history[i];
+    if (
+      Math.sign(a.player.tiles - a.bot.tiles) !==
+      Math.sign(b.player.tiles - b.bot.tiles)
+    )
+      lead = b.tick;
+  }
+  const stat = (v: string, l: string) =>
+    `<div style="background:rgba(255,255,255,.05);border-radius:12px;padding:10px 12px"><b style="display:block;font-size:22px;color:#f3f6fb">${v}</b><span style="font-size:12px;color:#9fb0c8">${l}</span></div>`;
+  const box = document.createElement("div");
+  box.id = "trainer-end";
+  box.setAttribute("role", "dialog");
+  box.style.cssText =
+    "position:fixed;inset:0;z-index:100000;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(4,8,14,.72);backdrop-filter:blur(3px);font-family:system-ui,sans-serif";
+  box.innerHTML = `<div style="width:min(720px,100%);max-height:100%;overflow:auto;background:#0e1520;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:22px 20px;box-shadow:0 20px 60px rgba(0,0,0,.6);color:#dfe7f2">
+    <div style="font-size:12px;letter-spacing:.3em;color:#9fb0c8;text-transform:uppercase">TRAINER.PRO · 1v1 vs ${TRAINER_BOT_NAME}</div>
+    <h2 style="margin:6px 0 2px;font-size:clamp(34px,8vw,56px);line-height:1;font-weight:900;color:${won ? "#57e6ff" : "#ff5fb0"}">${won ? "VICTORY" : "DEFEAT"}</h2>
+    <p id="trainer-end-record" style="margin:0 0 6px;color:#9fb0c8;font-size:14px" hidden></p>
+    <p style="margin:0 0 16px;color:#c3cbd8">${won ? `You beat ${TRAINER_BOT_NAME}` : `${TRAINER_BOT_NAME} beat you`} in ${clock(last.tick - t0)}${lead !== null ? `, the lead in land last changed at ${clock(lead - t0)}` : ""}.</p>
+    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin-bottom:16px">
+      ${stat(clock(last.tick - t0), "game time")}
+      ${stat(fmt(peak("player", "tiles")), "your biggest land")}
+      ${stat(fmt(peak("bot", "tiles")), "bot's biggest land")}
+      ${stat(fmt(peak("player", "troops")), "your biggest army")}
+      ${stat(fmt(peak("bot", "troops")), "bot's biggest army")}
+    </div>
+    <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:10px">
+      ${chart("Land", (s, w) => s[w].tiles)}
+      ${chart("Army", (s, w) => s[w].troops)}
+    </div>
+    <p style="margin:0 0 16px;font-size:13px;color:#9fb0c8"><span style="color:#57e6ff">━ you</span> &nbsp; <span style="color:#ff5fb0">━ ${TRAINER_BOT_NAME}</span></p>
+    <div style="display:flex;gap:10px;flex-wrap:wrap">
+      <a href="${trainerHome()}" style="flex:1 1 160px;text-align:center;padding:12px 16px;border-radius:999px;background:#57e6ff;color:#04121a;font-weight:800;text-decoration:none">▶ Play again</a>
+      <button type="button" id="trainer-end-close" style="flex:1 1 160px;padding:12px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.2);background:transparent;color:#dfe7f2;font-weight:700;cursor:pointer">Look at the map</button>
+    </div></div>`;
+  document.body.appendChild(box);
+  // The player's record against the bot, this game included (it may not be uploaded yet)
+  fetch(`${TRAINER_API}/me`, { credentials: "same-origin", cache: "no-store" })
+    .then((r) => (r.ok ? r.json() : null))
+    .then((d) => {
+      const el = box.querySelector<HTMLElement>("#trainer-end-record");
+      if (!d?.user || el === null) return;
+      const counted =
+        d.last !== null &&
+        Date.now() - d.last.at < 60_000 &&
+        d.last.won === won;
+      const w = d.wins + (won && !counted ? 1 : 0);
+      const l = d.losses + (!won && !counted ? 1 : 0);
+      el.textContent = `Your record vs ${TRAINER_BOT_NAME}: ${w} wins, ${l} losses`;
+      el.hidden = false;
+    })
+    .catch(() => {});
+  box
+    .querySelector("#trainer-end-close")
+    ?.addEventListener("click", () => box.remove());
+}
+
+/** The page shows a replay (#replay-viewer=<id>, admins only): no new match then. */
+export function trainerReplaying(): boolean {
+  return isTrainer() && window.location.hash.startsWith("#replay-viewer=");
+}
+
+export function trainerHome(): string {
+  return page()?.home ?? "/";
+}
+
+// The name the TRAINER.PRO page passed (the admin's Discord name), else null.
+export function trainerPlayerName(): ResolvedPlayerName | null {
+  if (!isTrainer()) return null;
+  const name = (QUERY.get("name") ?? "").trim().slice(0, 24);
+  return name ? { name, source: "stored", verified: false } : null;
+}
+
+function pick<T extends string>(
+  values: readonly T[],
+  wanted: string | null,
+  fallback: T,
+): T {
+  return values.find((v) => v === wanted) ?? fallback;
+}
+
+// Same rules as OpenFront's ranked 1v1 (MapPlaylist.get1v1Config), but the
+// opponent is one AI nation instead of a second human.
+// What the bot learned from top players (teamstats.pro /api/trainer/policy),
+// or undefined for OpenFront's plain nation AI.
+async function loadPolicy(): Promise<string | undefined> {
+  if (QUERY.get("bot") === "nation") return undefined;
+  try {
+    const r = await fetch("/api/trainer/policy", {
+      credentials: "same-origin",
+      signal: AbortSignal.timeout(5000),
+    });
+    if (!r.ok) return undefined;
+    const text = await r.text();
+    return text.length > 2 && text.length < 400000 ? text : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export async function startTrainerGame(): Promise<void> {
+  if (!isTrainer() || trainerReplaying()) return;
+  const trainerPolicy = await loadPolicy();
+  const q = QUERY;
+  const gameMap = pick(
+    Object.values(GameMapType),
+    q.get("map"),
+    GameMapType.Australia,
+  );
+  const difficulty = pick(
+    Object.values(Difficulty),
+    q.get("difficulty"),
+    Difficulty.Medium,
+  );
+  const compact = q.get("size") === "Compact";
+  const name = trainerPlayerName()?.name ?? "Trainee";
+  const gameID = generateID();
+  document.dispatchEvent(
+    new CustomEvent("join-lobby", {
+      detail: {
+        gameID,
+        gameStartInfo: {
+          gameID,
+          players: [
+            {
+              clientID: generateID(),
+              username: name,
+              clanTag: null,
+              cosmetics: {},
+            },
+          ],
+          config: {
+            gameMap,
+            gameMapSize: compact ? GameMapSize.Compact : GameMapSize.Normal,
+            gameType: GameType.Singleplayer,
+            gameMode: GameMode.FFA,
+            difficulty,
+            maxTimerValue: compact ? 10 : 15,
+            bots: compact ? 100 : 400,
+            nations: 1,
+            infiniteGold: false,
+            infiniteTroops: false,
+            donateGold: false,
+            donateTroops: false,
+            instantBuild: false,
+            randomSpawn: false,
+            spawnImmunityDuration: 30 * 10,
+            disabledUnits: [],
+            ...(trainerPolicy !== undefined ? { trainerPolicy } : {}),
+            trainerBotName: TRAINER_BOT_NAME,
+          },
+          lobbyCreatedAt: Date.now(),
+        },
+        source: "singleplayer",
+      },
+      bubbles: true,
+      composed: true,
+    }),
+  );
+}
