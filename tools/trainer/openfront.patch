@@ -0,0 +1,167 @@
+import {
+  Difficulty,
+  PlayerInfo,
+  PlayerType,
+  UnitType,
+} from "@openfront/engine-api/game/GameTypes";
+import {
+  Config,
+  NukeMagnitude,
+} from "@openfront/engine-lib/configuration/Config";
+import { PseudoRandom } from "@openfront/engine-lib/PseudoRandom";
+import { NationAllianceBehavior } from "@openfront/engine/execution/nation/NationAllianceBehavior";
+import { NationEmojiBehavior } from "@openfront/engine/execution/nation/NationEmojiBehavior";
+import { NationNukeBehavior } from "@openfront/engine/execution/nation/NationNukeBehavior";
+import { AiAttackBehavior } from "@openfront/engine/execution/utils/AiAttackBehavior";
+import { Game, Player } from "@openfront/engine/game/Game";
+import { setup } from "./util/Setup";
+import { TestConfig } from "./util/TestConfig";
+
+class RealNukeRadiusConfig extends TestConfig {
+  nukeMagnitudes(unitType: UnitType): NukeMagnitude {
+    return Config.prototype.nukeMagnitudes.call(this, unitType);
+  }
+}
+
+function conquerRect(game: Game, p: Player, x0: number, x1: number) {
+  for (let x = x0; x < x1; x++) {
+    for (let y = 0; y < 200; y++) p.conquer(game.ref(x, y));
+  }
+}
+
+// TRAINER.PRO 1v1 on the all-land map: our bot left, the human right.
+async function trainerGame(gold: bigint) {
+  const game = await setup(
+    "big_plains",
+    { difficulty: Difficulty.Impossible, trainerBotName: "Teamstats.PRO" },
+    [
+      new PlayerInfo("bot", PlayerType.Nation, null, "bot_id"),
+      new PlayerInfo("human", PlayerType.Human, null, "human_id"),
+    ],
+    undefined,
+    RealNukeRadiusConfig,
+  );
+  const bot = game.player("bot_id");
+  const human = game.player("human_id");
+  conquerRect(game, bot, 0, 100);
+  conquerRect(game, human, 100, 200);
+  bot.buildUnit(UnitType.MissileSilo, game.ref(5, 5), {});
+  bot.addGold(gold);
+  const random = () => new PseudoRandom(1);
+  const emoji = new NationEmojiBehavior(random(), game, bot);
+  const alliance = new NationAllianceBehavior(random(), game, bot, emoji);
+  const attack = new AiAttackBehavior(
+    random(),
+    game,
+    bot,
+    0.5,
+    0.3,
+    0.2,
+    alliance,
+    emoji,
+  );
+  const nukes = new NationNukeBehavior(random(), game, bot, attack, emoji);
+  return { game, bot, human, nukes, alliance };
+}
+
+function bombs(game: Game, bot: Player, type: UnitType) {
+  for (let i = 0; i < 3; i++) game.executeNextTick();
+  return bot.units(type);
+}
+
+describe("TRAINER.PRO bot", () => {
+  test("nukes the opponent's missile silo", async () => {
+    const { game, bot, human, nukes } = await trainerGame(5_000_000n);
+    const silo = human.buildUnit(UnitType.MissileSilo, game.ref(180, 150), {});
+    nukes.maybeSendNuke();
+    const sent = bombs(game, bot, UnitType.AtomBomb);
+    expect(sent).toHaveLength(1);
+    expect(sent[0].targetTile()).toBe(silo.tile());
+  });
+
+  test("hydrogen bomb on the most cities once it has 5M gold and they have no silo", async () => {
+    const { game, bot, human, nukes } = await trainerGame(5_000_000n);
+    human.buildUnit(UnitType.City, game.ref(190, 20), {});
+    for (const [x, y] of [
+      [150, 150],
+      [152, 152],
+      [148, 151],
+    ]) {
+      human.buildUnit(UnitType.City, game.ref(x, y), {});
+    }
+    nukes.maybeSendNuke();
+    const sent = bombs(game, bot, UnitType.HydrogenBomb);
+    expect(sent).toHaveLength(1);
+    const target = sent[0].targetTile()!;
+    expect(game.x(target)).toBeLessThan(160);
+    expect(game.y(target)).toBeGreaterThan(140);
+  });
+
+  test("no hydrogen bomb below 5M gold", async () => {
+    const { game, bot, human, nukes } = await trainerGame(4_000_000n);
+    human.buildUnit(UnitType.City, game.ref(150, 150), {});
+    nukes.maybeSendNuke();
+    expect(bombs(game, bot, UnitType.HydrogenBomb)).toHaveLength(0);
+    expect(bot.units(UnitType.AtomBomb)).toHaveLength(0);
+  });
+
+  test("rejects every alliance request", async () => {
+    const { game, bot, human, alliance } = await trainerGame(0n);
+    for (let i = 0; i < 200; i++) game.executeNextTick();
+    const request = human.createAllianceRequest(bot);
+    expect(request).not.toBeNull();
+    alliance.handleAllianceRequests();
+    expect(bot.isAlliedWith(human)).toBe(false);
+    expect(bot.incomingAllianceRequests()).toHaveLength(0);
+  });
+});
+
+describe("TRAINER.PRO bot boats", () => {
+  test("boats far across the water to free land", async () => {
+    const game = await setup(
+      "world",
+      { difficulty: Difficulty.Impossible, trainerBotName: "Teamstats.PRO" },
+      [new PlayerInfo("bot", PlayerType.Nation, null, "bot_id")],
+    );
+    const bot = game.player("bot_id");
+    // A small coastal patch
+    let shore = -1;
+    game.forEachTile((t) => {
+      if (shore < 0 && game.isShore(t) && game.isLand(t)) shore = t;
+    });
+    const sx = game.x(shore);
+    const sy = game.y(shore);
+    for (let x = sx - 3; x <= sx + 3; x++) {
+      for (let y = sy - 3; y <= sy + 3; y++) {
+        if (game.isValidCoord(x, y) && game.isLand(game.ref(x, y))) {
+          bot.conquer(game.ref(x, y));
+        }
+      }
+    }
+    bot.addTroops(100_000);
+    const random = () => new PseudoRandom(1);
+    const emoji = new NationEmojiBehavior(random(), game, bot);
+    const alliance = new NationAllianceBehavior(random(), game, bot, emoji);
+    const attack = new AiAttackBehavior(
+      random(),
+      game,
+      bot,
+      0.5,
+      0.3,
+      0.2,
+      alliance,
+      emoji,
+    );
+    attack.maybeAttack();
+    for (let i = 0; i < 3; i++) game.executeNextTick();
+    const boats = bot.units(UnitType.TransportShip);
+    expect(boats.length).toBeGreaterThan(0);
+    // Sent far from home, not just to the next coast
+    const far = boats.some(
+      (b) =>
+        b.targetTile() !== undefined &&
+        game.manhattanDist(shore, b.targetTile()!) > 50,
+    );
+    expect(far).toBe(true);
+  });
+});
diff --git a/tests/TrainerDefense.test.ts b/tests/TrainerDefense.test.ts
new file mode 100644
index 00000000..fc1aa284
--- /dev/null
+++ b/tests/TrainerDefense.test.ts
@@ -0,0 +1,81 @@
+import {
+  Difficulty,
+  PlayerInfo,
+  PlayerType,
+} from "@openfront/engine-api/game/GameTypes";
+import { PseudoRandom } from "@openfront/engine-lib/PseudoRandom";
+import { AttackExecution } from "@openfront/engine/execution/AttackExecution";
+import { NationAllianceBehavior } from "@openfront/engine/execution/nation/NationAllianceBehavior";
+import { NationEmojiBehavior } from "@openfront/engine/execution/nation/NationEmojiBehavior";
+import { AiAttackBehavior } from "@openfront/engine/execution/utils/AiAttackBehavior";
+import { Game, Player } from "@openfront/engine/game/Game";
+import { setup } from "./util/Setup";
+
+function conquerRect(game: Game, p: Player, x0: number, x1: number) {
+  for (let x = x0; x < x1; x++) {
+    for (let y = 0; y < 200; y++) p.conquer(game.ref(x, y));
+  }
+}
+
+// TRAINER.PRO: humans throw nearly their whole army at the bot (27 replays, 2026-11-01).
+// With attack.defend on, the bot answers with its army instead of the few % its reserve left.
+async function allIn(defend: number) {
+  const game = await setup(
+    "big_plains",
+    {
+      difficulty: Difficulty.Impossible,
+      trainerBotName: "Teamstats.PRO",
+      trainerPolicy: JSON.stringify({
+        v: 1,
+        attack: { defend, reserveRatio: 0.6, expandRatio: 0.3 },
+      }),
+    },
+    [
+      new PlayerInfo("bot", PlayerType.Nation, null, "bot_id"),
+      new PlayerInfo("human", PlayerType.Human, null, "human_id"),
+    ],
+  );
+  const bot = game.player("bot_id");
+  const human = game.player("human_id");
+  conquerRect(game, bot, 0, 100);
+  conquerRect(game, human, 100, 200);
+  bot.addTroops(200_000 - bot.troops());
+  human.addTroops(250_000 - human.troops());
+  const random = () => new PseudoRandom(1);
+  const emoji = new NationEmojiBehavior(random(), game, bot);
+  const alliance = new NationAllianceBehavior(random(), game, bot, emoji);
+  const attack = new AiAttackBehavior(
+    random(),
+    game,
+    bot,
+    0.5,
+    0.6,
+    0.3,
+    alliance,
+    emoji,
+  );
+  game.addExecution(new AttackExecution(240_000, human, bot.id()));
+  game.executeNextTick();
+  game.executeNextTick();
+  const before = bot.troops();
+  const incoming = () =>
+    bot.incomingAttacks().reduce((s, a) => s + a.troops(), 0);
+  const coming = incoming();
+  (attack as unknown as { retaliate(): boolean }).retaliate();
+  game.executeNextTick();
+  game.executeNextTick();
+  // Opposite attacks cancel each other: what our answer took off theirs
+  return { before, sent: coming - incoming() };
+}
+
+describe("TRAINER.PRO bot defense", () => {
+  test("cancels an all-in with most of its army", async () => {
+    const { before, sent } = await allIn(1);
+    expect(sent).toBeGreaterThan(before * 0.7);
+  });
+
+  test("keeps the old small answer without attack.defend", async () => {
+    const { before, sent } = await allIn(0);
+    expect(sent).toBeLessThan(before * 0.5);
+  });
+});
diff --git a/tests/TrainerRules.test.ts b/tests/TrainerRules.test.ts
new file mode 100644
index 00000000..51d2f829
--- /dev/null
+++ b/tests/TrainerRules.test.ts
@@ -0,0 +1,107 @@
+import {
+  Difficulty,
+  GameMapSize,
+  GameMapType,
+  GameMode,
+  GameType,
+  PlayerInfo,
+  PlayerType,
+} from "@openfront/engine-api/game/GameTypes";
+import { GameConfig } from "@openfront/engine-api/Schemas";
+import { EngineConfig } from "@openfront/engine/configuration/EngineConfig";
+import {
+  trainerAttackPlan,
+  trainerPolicy,
+} from "@openfront/engine/execution/nation/TrainerPolicy";
+import { Game } from "@openfront/engine/game/Game";
+
+function config(trainerBotName?: string): EngineConfig {
+  const c: GameConfig = {
+    gameMap: GameMapType.Australia,
+    gameMapSize: GameMapSize.Normal,
+    gameMode: GameMode.FFA,
+    gameType: GameType.Singleplayer,
+    difficulty: Difficulty.Impossible,
+    nations: 1,
+    donateGold: false,
+    donateTroops: false,
+    bots: 400,
+    infiniteGold: false,
+    infiniteTroops: false,
+    instantBuild: false,
+    randomSpawn: false,
+    ...(trainerBotName !== undefined ? { trainerBotName } : {}),
+  };
+  return new EngineConfig(c, false);
+}
+
+describe("TRAINER.PRO: the bot plays by human rules", () => {
+  const nation = new PlayerInfo("Bot", PlayerType.Nation, null, "nation1");
+  const human = new PlayerInfo("Me", PlayerType.Human, "client1", "human1");
+  test("Impossible nations normally start with more troops", () => {
+    expect(config().startManpower(nation)).toBeGreaterThan(
+      config().startManpower(human),
+    );
+  });
+  test("the trainer bot starts like a human", () => {
+    const c = config("Teamstats.PRO");
+    expect(c.startManpower(nation)).toBe(c.startManpower(human));
+  });
+});
+
+describe("TRAINER.PRO: policy per map and pro attack plan", () => {
+  const game = (map: GameMapType, policy: object) =>
+    ({
+      config: () => ({
+        gameConfig: () => ({
+          gameMap: map,
+          trainerBotName: "Teamstats.PRO",
+          trainerPolicy: JSON.stringify(policy),
+        }),
+      }),
+    }) as unknown as Game;
+  const policy = {
+    v: 1,
+    attack: { triggerRatio: 0.5, punchRatio: 0.05 },
+    maps: { Iceland: { attack: { punchRatio: 0.1 } } },
+  };
+  test("a map's own numbers go on top of the rest", () => {
+    const iceland = trainerPolicy(game(GameMapType.Iceland, policy));
+    expect(iceland?.attack).toEqual({ triggerRatio: 0.5, punchRatio: 0.1 });
+    const asia = trainerPolicy(game(GameMapType.Asia, policy));
+    expect(asia?.attack).toEqual({ triggerRatio: 0.5, punchRatio: 0.05 });
+  });
+  test("pros keep troops near fastest growth and punch with ~7% boats", () => {
+    const plan = trainerAttackPlan(game(GameMapType.Asia, { v: 1 }));
+    expect(plan).toEqual({
+      growth: 0.42,
+      punch: 0.07,
+      crush: 2,
+      raidEvery: null,
+      raidTicks: 30,
+      cutoff: 0,
+      breakOut: 0.3,
+      press: 1.2,
+      stackEvery: null,
+      stackRatio: 0.4,
+      snipeTiles: 400,
+      botRamp: 900,
+      lookahead: 0.5,
+      braceTicks: 150,
+      atomGold: 0,
+      defend: false,
+      trickle: false,
+    });
+  });
+
+  test("the new defense is on only when the policy says so", () => {
+    expect(
+      trainerAttackPlan(game(GameMapType.Asia, { v: 1, attack: { defend: 1 } }))
+        ?.defend,
+    ).toBe(true);
+    expect(
+      trainerAttackPlan(game(GameMapType.Asia, { v: 1, attack: { defend: 0 } }))
+        ?.defend,
+    ).toBe(false);
+  });
+});
diff --git a/tests/TrainerSpawn.test.ts b/tests/TrainerSpawn.test.ts
new file mode 100644
index 00000000..65efcec3
--- /dev/null
+++ b/tests/TrainerSpawn.test.ts
@@ -0,0 +1,108 @@
+import {
+  Cell,
+  Difficulty,
+  Nation,
+  PlayerInfo,
+  PlayerType,
+} from "@openfront/engine-api/game/GameTypes";
+import { NationExecution } from "@openfront/engine/execution/NationExecution";
+import { SpawnExecution } from "@openfront/engine/execution/SpawnExecution";
+import { Game, Player } from "@openfront/engine/game/Game";
+import { setup } from "./util/Setup";
+import { TestConfig } from "./util/TestConfig";
+
+const GAME_ID = "trainer_spawn";
+
+// TRAINER.PRO: the bot's SpawnExecution can find its tile taken when it runs (another
+// spawn landed there the same tick). It used to never try again, so the bot never showed up.
+async function botWhoseSpawnFails(): Promise<{
+  game: Game;
+  bot: Player;
+  human: Player;
+}> {
+  const nation = new Nation(
+    new Cell(50, 50),
+    new PlayerInfo("Teamstats.PRO", PlayerType.Nation, null, "bot_id"),
+  );
+  const game = await setup(
+    "big_plains",
+    { difficulty: Difficulty.Impossible, trainerBotName: "Teamstats.PRO" },
+    [],
+    undefined,
+    TestConfig,
+    false,
+    [nation],
+  );
+  // Self-play has no human: the bot spawns in the spawn phase (with one it waits, below)
+  const human = game.addPlayer(
+    new PlayerInfo("other", PlayerType.Bot, null, "other_id"),
+  );
+  game.addExecution(new NationExecution(GAME_ID, game.nations()[0]));
+  const queued = () =>
+    (game as unknown as { executions(): unknown[] })
+      .executions()
+      .some((e) => e instanceof SpawnExecution);
+  for (let i = 0; i < 20 && !queued(); i++) game.executeNextTick();
+  expect(queued()).toBe(true);
+  // Before it runs, the whole land around the bot's spawn cell gets taken
+  for (let x = 0; x < 120; x++) {
+    for (let y = 0; y < 120; y++) human.conquer(game.ref(x, y));
+  }
+  game.executeNextTick();
+  const bot = game.player("bot_id");
+  expect(bot.hasSpawned()).toBe(false);
+  for (const t of Array.from(human.tiles())) human.relinquish(t);
+  return { game, bot, human };
+}
+
+describe("TRAINER.PRO bot spawn", () => {
+  test("waits for the human, then spawns away from them", async () => {
+    const nation = new Nation(
+      new Cell(50, 50),
+      new PlayerInfo("Teamstats.PRO", PlayerType.Nation, null, "bot_id"),
+    );
+    const game = await setup(
+      "big_plains",
+      { difficulty: Difficulty.Impossible, trainerBotName: "Teamstats.PRO" },
+      [],
+      undefined,
+      TestConfig,
+      false,
+      [nation],
+    );
+    const info = new PlayerInfo(
+      "human",
+      PlayerType.Human,
+      "client_h",
+      "human_id",
+    );
+    game.addPlayer(info);
+    game.addExecution(new NationExecution(GAME_ID, game.nations()[0]));
+    for (let i = 0; i < 20; i++) game.executeNextTick();
+    const bot = game.player("bot_id");
+    expect(bot.hasSpawned()).toBe(false);
+    game.addExecution(new SpawnExecution(GAME_ID, info, game.ref(60, 60)));
+    game.executeNextTick();
+    game.endSpawnPhase();
+    for (let i = 0; i < 10; i++) game.executeNextTick();
+    expect(bot.hasSpawned()).toBe(true);
+    expect(
+      Math.sqrt(game.euclideanDistSquared(bot.spawnTile()!, game.ref(60, 60))),
+    ).toBeGreaterThan(20);
+  });
+
+  test("tries again in the spawn phase after its spawn failed", async () => {
+    const { game, bot } = await botWhoseSpawnFails();
+    for (let i = 0; i < 10; i++) game.executeNextTick();
+    expect(game.inSpawnPhase()).toBe(true);
+    expect(bot.hasSpawned()).toBe(true);
+  });
+
+  test("still spawns when the spawn phase ended after its spawn failed", async () => {
+    const { game, bot } = await botWhoseSpawnFails();
+    game.endSpawnPhase();
+    for (let i = 0; i < 10; i++) game.executeNextTick();
+    expect(bot.hasSpawned()).toBe(true);
+    expect(bot.numTilesOwned()).toBeGreaterThan(0);
+  });
+});
