+// to attacks (Kris, 2026-10-13): bots that round off our land come first now, and the
+// cut-off pull is a small learned weight.
+const CUTOFF_WEIGHT = 0;
+// Bembe walled the bot in (2026-10-13): with under 30% of its land border still on bots
+// or free land, it breaks out to those bots at once.
+const BREAK_OUT = 0.3;
+// Small attacks into a player who defends at once just burn troops (Bembe): only with 20%
+// more troops than them. Boat stacking (3 boats of 40%, then all in) starts off; training
+// tries it.
+const PRESS_RATIO = 1.2;
+const STACK_RATIO = 0.4;
+// Only the attack that takes a bot under 100 tiles gets its gold (Bembe, 2026-10-13): a
+// bot the opponent is eating gets sniped by us once it is down to 400 tiles.
+const SNIPE_TILES = 400;
+// One bot at a time for 3 minutes was too slow (Kris): one more bot every 90 s of play
+const BOT_RAMP = 900;
+// Think a step ahead when picking bots (Kris/Bembe): half the land a bot opens up counts
+const LOOKAHEAD = 0.5;
+// A player who stops attacking for 15 s is saving up for a big strike (Bembe)
+const BRACE_TICKS = 150;
+
+export interface TrainerAttackPlan {
+  growth: number;
+  punch: number;
+  crush: number;
+  raidEvery: number | null;
+  raidTicks: number;
+  cutoff: number;
+  breakOut: number;
+  press: number;
+  stackEvery: number | null;
+  stackRatio: number;
+  snipeTiles: number;
+  botRamp: number;
+  lookahead: number;
+  braceTicks: number;
+  atomGold: number;
+  defend: boolean;
+  trickle: boolean;
+}
+
+/** How the trainer bot fights the opponent, or null outside TRAINER.PRO. */
+export function trainerAttackPlan(
+  game: Game,
+  playerName?: string,
+): TrainerAttackPlan | null {
+  if (!isTrainerGame(game)) return null;
+  const learned = trainerPolicy(game, playerName)?.attack;
+  const raidEvery = clamp(learned?.raidEvery, 0, 3000) ?? 0;
+  const stackEvery = clamp(learned?.stackEvery, 0, 3000) ?? 0;
+  return {
+    growth: clamp(learned?.growthRatio, 0.2, 0.7) ?? GROWTH_RATIO,
+    punch: clamp(learned?.punchRatio, 0.02, 0.2) ?? PUNCH_RATIO,
+    crush: clamp(learned?.crushRatio, 1.2, 5) ?? CRUSH_RATIO,
+    raidEvery: raidEvery < 300 ? null : Math.round(raidEvery),
+    raidTicks: Math.round(clamp(learned?.raidTicks, 10, 100) ?? RAID_TICKS),
+    cutoff: clamp(learned?.cutoffWeight, -1, 1) ?? CUTOFF_WEIGHT,
+    breakOut: clamp(learned?.breakOut, 0.05, 0.6) ?? BREAK_OUT,
+    // never less than 20% more troops than them: training went to 0.5 against itself
+    press: clamp(learned?.pressRatio, 1.2, 3) ?? PRESS_RATIO,
+    stackEvery: stackEvery < 300 ? null : Math.round(stackEvery),
+    stackRatio: clamp(learned?.stackRatio, 0.2, 0.6) ?? STACK_RATIO,
+    snipeTiles: Math.round(clamp(learned?.snipeTiles, 0, 1000) ?? SNIPE_TILES),
+    botRamp: Math.round(clamp(learned?.botRamp, 300, 3000) ?? BOT_RAMP),
+    lookahead: clamp(learned?.lookahead, 0, 2) ?? LOOKAHEAD,
+    braceTicks: Math.round(clamp(learned?.braceTicks, 0, 600) ?? BRACE_TICKS),
+    atomGold: Math.round(clamp(learned?.atomGold, 0, 5_000_000) ?? 0),
+    defend: (learned?.defend ?? 0) >= 0.5,
+    trickle: (learned?.trickle ?? 0) >= 0.5,
+  };
+}
