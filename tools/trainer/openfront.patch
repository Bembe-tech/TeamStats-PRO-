@@ -0,0 +1,119 @@
+// TRAINER.PRO analysis: replays a recorded game vs our bot (teamstats.pro /api/trainer/game/<id>)
+// headless and returns a timeline of both sides, so we can see how the bot lost.
+import {
+  GameMapType,
+  PlayerType,
+  UnitType,
+} from "@openfront/engine-api/game/GameTypes";
+import { MapManifest } from "@openfront/engine-api/game/MapFiles";
+import { GameStartInfo } from "@openfront/engine-api/Schemas";
+import { createGameRunner } from "@openfront/engine/GameRunner";
+import {
+  GameMapLoader,
+  loadMapFiles,
+  MapData,
+} from "@openfront/shared/GameMapLoader";
+import fs from "fs";
+import path from "path";
+
+class PlayDirMapLoader implements GameMapLoader {
+  private manifest: Record<string, string>;
+  constructor(private playDir: string) {
+    this.manifest = JSON.parse(
+      fs.readFileSync(path.join(playDir, "asset-manifest.json"), "utf8"),
+    );
+  }
+  private file(folder: string, name: string): string {
+    return path.join(this.playDir, this.manifest[`maps/${folder}/${name}`]);
+  }
+  getMapData(map: GameMapType): MapData {
+    const key = Object.keys(GameMapType).find(
+      (k) => GameMapType[k as keyof typeof GameMapType] === map,
+    )!;
+    const folder = key.toLowerCase();
+    const bin = (name: string) => async () =>
+      new Uint8Array(fs.readFileSync(this.file(folder, name)));
+    return {
+      mapBin: bin("map.bin"),
+      map4xBin: bin("map4x.bin"),
+      map16xBin: bin("map16x.bin"),
+      manifest: async () =>
+        JSON.parse(
+          fs.readFileSync(this.file(folder, "manifest.json"), "utf8"),
+        ) as MapManifest,
+      webpPath: "",
+      layerPng: async () => {
+        throw new Error("no layers");
+      },
+    };
+  }
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export async function replayTrainerGame(rec: any, playDir: string) {
+  const start = {
+    gameID: rec.info.gameID,
+    lobbyCreatedAt: rec.info.lobbyCreatedAt,
+    config: rec.info.config,
+    players: rec.info.players,
+  } as GameStartInfo;
+  const files = await loadMapFiles(
+    new PlayDirMapLoader(playDir),
+    start.config.gameMap,
+    start.config.gameMapSize,
+  );
+  let err = "";
+  const runner = await createGameRunner(start, undefined, files, (u) => {
+    if ("errMsg" in u) err = u.errMsg;
+  });
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const game = (runner as any).game;
+  const byTurn = new Map<number, unknown[]>();
+  for (const t of rec.turns) byTurn.set(t.turnNumber, t.intents ?? []);
+  const last = Math.max(
+    rec.info.num_turns ?? 0,
+    ...rec.turns.map((t: { turnNumber: number }) => t.turnNumber),
+  );
+  const timeline: unknown[] = [];
+  const side = (p: any) =>
+    p === undefined
+      ? null
+      : {
+          tiles: p.numTilesOwned(),
+          troops: Math.round(p.troops()),
+          max: Math.round(game.config().maxTroops(p)),
+          gold: Number(p.gold()),
+          alive: p.isAlive(),
+          city: p.unitsOwned(UnitType.City),
+          port: p.unitsOwned(UnitType.Port),
+          post: p.unitsOwned(UnitType.DefensePost),
+          silo: p.unitsOwned(UnitType.MissileSilo),
+          sam: p.unitsOwned(UnitType.SAMLauncher),
+          warship: p.unitsOwned(UnitType.Warship),
+          // attacks between the two sides, troops in them
+          out: p.outgoingAttacks().map((a: any) => ({
+            to: a.target().isPlayer?.() ? a.target().type() : "free",
+            troops: Math.round(a.troops()),
+          })),
+        };
+  for (let turn = 0; turn <= last; turn++) {
+    runner.addTurn({
+      turnNumber: turn,
+      intents: byTurn.get(turn) ?? [],
+    } as never);
+    runner.executeNextTick();
+    if (err) throw new Error(err);
+    if (game.ticks() % 50 === 0 || turn === last) {
+      const players = game.players();
+      const human = players.find((p: any) => p.type() === PlayerType.Human);
+      const bot = players.find((p: any) => p.type() === PlayerType.Nation);
+      timeline.push({
+        tick: game.ticks(),
+        spawn: game.inSpawnPhase(),
+        human: side(human),
+        bot: side(bot),
+      });
+    }
+  }
+  return timeline;
+}
