+// TRAINER.PRO: what the trainer bot learned from top players' ranked 1v1 games
+// (made by teamstats.pro's bot-dataset.js, passed in GameConfig.trainerPolicy as JSON).
+// The nation keeps OpenFront's own AI machinery; these values replace its
+// hand-picked numbers: where to spawn, how much army to keep when attacking,
+// how often to act, and which structures to build per city.
+import {
+  GameMapSize,
+  PlayerType,
+  UnitType,
+} from "@openfront/engine-api/game/GameTypes";
+import { Game, Player } from "../../game/Game";
+
+export interface TrainerPolicy {
+  v: number;
+  spawns?: Record<string, [number, number][]>; // map -> normalized x, y
+  attack?: {
+    triggerRatio?: number;
+    reserveRatio?: number;
+    expandRatio?: number;
+    attackRate?: number; // ticks between decisions
+    growthRatio?: number; // troops kept at home (share of max): fastest growth near 0.42
+    punchRatio?: number; // share of troops per boat sent at the opponent
+    crushRatio?: number; // our troops / theirs from which we attack with everything
+    raidEvery?: number; // ticks between fast raids (90% in, then back); under 300 = off
+    raidTicks?: number; // how long a raid runs before the retreat
+    cutoffWeight?: number; // pull toward bots the opponent borders (-1..1); compact land wins at 0
+    breakOut?: number; // share of our land border still open (bots / free land) below which we break out
+    pressRatio?: number; // our troops / theirs needed for small attacks on the opponent
+    stackEvery?: number; // ticks between boat stacks (boats park troops off our cap); under 300 = off
+    stackRatio?: number; // share of troops per stacked boat
+    snipeTiles?: number; // a bot the opponent attacks gets sniped below this many tiles; 0 = off
+    botRamp?: number; // ticks of play per extra bot attacked at the same time (1 bot at first)
+    lookahead?: number; // weight of the bots' land that taking a bot opens up (0..2)
+    braceTicks?: number; // opponent idle this long = saving up for a strike: we keep troops home; 0 = off
+    atomGold?: number; // with this much gold, an atom bomb on their cities (nuke style); 0 = off
+    trickle?: number; // 1 = attacks on bots start at 95% and get topped up in small steps (troop saving, slower in tests); 0 = all at once
+    defend?: number; // 1 = answer attacks with the whole army, calling back attacks on bots (trainerDefend); 0 = off
+  };
+  boats?: {
+    every?: number; // ticks between boats to bots / free land, from top players
+    ratio?: number; // share of troops top players send per boat (info only: far boats carry 1%)
+  };
+  structures?: {
+    ratioPerCity?: Partial<Record<"port" | "fac" | "sam" | "silo", number>>;
+    first?: "city" | "port" | "fac";
+    siloCities?: number; // our one missile silo goes up with this many cities (Normal maps)
+  };
+  // Each map plays a bit differently (Bembe): what training found per map, over the rest
+  maps?: Record<string, Pick<TrainerPolicy, "attack" | "boats" | "structures">>;
+}
+
+// The policy with its own map's numbers on top (one copy per policy and map)
+const perMap = new WeakMap<TrainerPolicy, Map<string, TrainerPolicy>>();
+function forMap(p: TrainerPolicy, map: string): TrainerPolicy {
+  const m = p.maps?.[map];
+  if (m === undefined) return p;
+  let byMap = perMap.get(p);
+  if (byMap === undefined) perMap.set(p, (byMap = new Map()));
+  let merged = byMap.get(map);
+  if (merged === undefined) {
+    merged = {
+      ...p,
+      attack: { ...p.attack, ...m.attack },
+      boats: { ...p.boats, ...m.boats },
+      structures: {
+        ...p.structures,
+        ...m.structures,
+        ratioPerCity: {
+          ...p.structures?.ratioPerCity,
+          ...m.structures?.ratioPerCity,
+        },
+      },
+    };
+    byMap.set(map, merged);
+  }
+  return merged;
+}
+
+let cachedSource: string | undefined;
+let cached: TrainerPolicy | null = null;
+
+// Self-play training (tools/trainer-selfplay): each bot of a game gets its own policy,
+// by player name. Empty in the browser game.
+const overrides = new Map<string, TrainerPolicy>();
+export function setTrainerPolicyFor(
+  name: string,
+  policy: TrainerPolicy | null,
+) {
+  if (policy === null) overrides.delete(name);
+  else overrides.set(name, policy);
+}
+
+export function trainerPolicy(
+  game: Game,
+  playerName?: string,
+): TrainerPolicy | null {
+  const map = game.config().gameConfig().gameMap;
+  if (playerName !== undefined && overrides.has(playerName)) {
+    return forMap(overrides.get(playerName)!, map);
+  }
+  const src = game.config().gameConfig().trainerPolicy;
+  if (src === undefined || src === null || src === "") return null;
+  if (src !== cachedSource) {
+    cachedSource = src;
+    try {
+      cached = JSON.parse(src) as TrainerPolicy;
+    } catch {
+      cached = null;
+    }
+  }
+  return cached === null ? null : forMap(cached, map);
+}
+
+const clamp = (x: number | undefined, lo: number, hi: number) =>
+  typeof x === "number" && Number.isFinite(x)
+    ? Math.min(hi, Math.max(lo, x))
+    : undefined;
+
+export function learnedRatio(value: number | undefined): number | undefined {
+  return clamp(value, 0.02, 0.95);
+}
+
+export function learnedAttackRate(
+  value: number | undefined,
+): number | undefined {
+  const v = clamp(value, 15, 150);
+  return v === undefined ? undefined : Math.round(v);
+}
+
+export const POLICY_UNIT: Record<string, UnitType> = {
+  port: UnitType.Port,
+  fac: UnitType.Factory,
+  sam: UnitType.SAMLauncher,
+  silo: UnitType.MissileSilo,
+  city: UnitType.City,
+};
+
+/** True in a TRAINER.PRO game (the opponent is our bot, not a plain nation). */
+export function isTrainerGame(game: Game): boolean {
+  return game.config().gameConfig().trainerBotName !== undefined;
+}
+
+// Without learned values: a far boat every 30 s. Far boats carry 1% of the troops
+// (Bembe): they only open a beachhead, the land attack from it follows.
+const DEFAULT_BOAT_EVERY = 300;
+const FAR_BOAT_RATIO = 0.01;
+
+/** How often and how big the trainer bot's far boats are, or null outside TRAINER.PRO. */
+export function trainerBoatPlan(
+  game: Game,
+  playerName?: string,
+): { every: number; ratio: number } | null {
+  if (!isTrainerGame(game)) return null;
+  const learned = trainerPolicy(game, playerName)?.boats;
+  const every = clamp(learned?.every, 100, 1800);
+  return {
+    every: every === undefined ? DEFAULT_BOAT_EVERY : Math.round(every),
+    ratio: FAR_BOAT_RATIO,
+  };
+}
+
+/** Share of its troop cap the trainer bot keeps at home while bots are left (top players: ~30%). */
+export const TRAINER_HOME_SHARE = 0.28;
+
+/** Troops vs the opponent's from which the trainer bot, walled in with no coast, breaks through it. */
+export const TRAINER_RING_BREAK = 1.1;
+
+/** Troops vs the opponent's whole army from which the trainer bot raids; a raid also keeps half their army home. */
+export const TRAINER_RAID_EDGE = 1.6;
+
+/** Gold the trainer bot needs before it fires a hydrogen bomb at an opponent without a silo. */
+export const TRAINER_HYDRO_GOLD = 5_000_000n;
+
+/** True on a compact map: no missile silo and no warships there (Bembe), cities instead. */
+export function isCompactMap(game: Game): boolean {
+  return game.config().gameConfig().gameMapSize === GameMapSize.Compact;
+}
+
+/** The trainer bot's opponent: the human, else (self-play) the other nation. */
+export function trainerOpponentOf(game: Game, player: Player): Player | null {
+  if (!isTrainerGame(game)) return null;
+  const alive = game.players().filter((p) => p.isAlive() && p !== player);
+  return (
+    alive.find((p) => p.type() === PlayerType.Human) ??
+    alive.find((p) => p.type() === PlayerType.Nation) ??
+    null
+  );
