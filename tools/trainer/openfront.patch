+// TRAINER.PRO self-play: one headless ranked-1v1-like game between two trainer bots
+// ("A" and "B", each with its own policy) among the map's bots. Bundled by
+// teamstats.pro's tools/trainer/build-selfplay.sh into tools/trainer-selfplay/game.cjs
+// and run by tools/trainer-selfplay/train.cjs on worker threads.
+import {
+  Cell,
+  Difficulty,
+  GameMapSize,
+  GameMapType,
+  GameMode,
+  GameType,
+  Nation,
+  PlayerInfo,
+  PlayerType,
+  UnitType,
+} from "@openfront/engine-api/game/GameTypes";
+import { MapManifest } from "@openfront/engine-api/game/MapFiles";
+import { GameConfig, GameStartInfo } from "@openfront/engine-api/Schemas";
+import { loadTerrainMap } from "@openfront/engine-lib/game/TerrainMapLoader";
+import { PseudoRandom } from "@openfront/engine-lib/PseudoRandom";
+import { simpleHash } from "@openfront/engine-lib/Util";
+import { EngineConfig } from "@openfront/engine/configuration/EngineConfig";
+import { Executor } from "@openfront/engine/execution/ExecutionManager";
+import {
+  setTrainerPolicyFor,
+  TrainerPolicy,
+} from "@openfront/engine/execution/nation/TrainerPolicy";
+import { createGame } from "@openfront/engine/game/GameImpl";
+import { createNationsForGame } from "@openfront/engine/game/NationCreation";
+import { GameRunner } from "@openfront/engine/GameRunner";
+import {
+  GameMapLoader,
+  loadMapFiles,
+  MapData,
+} from "@openfront/shared/GameMapLoader";
+import fs from "fs";
+import path from "path";
+
+/** Reads maps from the TRAINER.PRO client build (trainer/play), whose files have hashed names. */
+class PlayDirMapLoader implements GameMapLoader {
+  private manifest: Record<string, string>;
+  constructor(private playDir: string) {
+    this.manifest = JSON.parse(
+      fs.readFileSync(path.join(playDir, "asset-manifest.json"), "utf8"),
+    );
+  }
+  private file(folder: string, name: string): string {
+    const rel = this.manifest[`maps/${folder}/${name}`];
+    if (rel === undefined)
+      throw new Error(`map file missing: ${folder}/${name}`);
+    return path.join(this.playDir, rel);
+  }
+  getMapData(map: GameMapType): MapData {
+    const key = Object.keys(GameMapType).find(
+      (k) => GameMapType[k as keyof typeof GameMapType] === map,
+    );
+    if (key === undefined) throw new Error(`unknown map: ${map}`);
+    const folder = key.toLowerCase();
+    const bin = (name: string) => async () =>
+      new Uint8Array(fs.readFileSync(this.file(folder, name)));
+    return {
+      mapBin: bin("map.bin"),
+      map4xBin: bin("map4x.bin"),
+      map16xBin: bin("map16x.bin"),
+      manifest: async () =>
+        JSON.parse(
+          fs.readFileSync(this.file(folder, "manifest.json"), "utf8"),
+        ) as MapManifest,
+      webpPath: "",
+      layerPng: async () => {
+        throw new Error("no layers in self-play");
+      },
+    };
+  }
+}
+
+export interface SelfPlayGame {
+  playDir: string;
+  map: string; // GameMapType value, e.g. "Australia"
+  compact: boolean;
+  seed: string;
+  a: TrainerPolicy;
+  b: TrainerPolicy;
+  // Only this many ticks of play (after the spawn phase); the whole game when unset.
+  // Humans out-grow the bot in the first 2 minutes (teamstats.pro, 2026-11-01): short games
+  // measure that start.
+  stopAfter?: number;
+}
+
+export interface SelfPlayResult {
+  winner: "A" | "B" | "draw";
+  tilesA: number;
+  tilesB: number;
+  ticks: number;
+  ms: number;
+  // What each side owned at the end (checks the bot's rules)
+  units: Record<"A" | "B", Record<string, number>>;
+  troopShare: Record<"A" | "B", number>; // average troops / max troops
+  land: Record<"A" | "B", number[]>; // tiles every 30 s of play
+}
+
+export async function runSelfPlayGame(
+  g: SelfPlayGame,
+): Promise<SelfPlayResult> {
+  const t0 = Date.now();
+  console.debug = () => {};
+  const config: GameConfig = {
+    gameMap: g.map as GameMapType,
+    gameMapSize: g.compact ? GameMapSize.Compact : GameMapSize.Normal,
+    gameType: GameType.Public,
+    gameMode: GameMode.FFA,
+    difficulty: Difficulty.Impossible,
+    maxTimerValue: g.compact ? 10 : 15,
+    bots: g.compact ? 100 : 400,
+    nations: 2,
+    infiniteGold: false,
+    infiniteTroops: false,
+    donateGold: false,
+    donateTroops: false,
+    instantBuild: false,
+    randomSpawn: false,
+    spawnImmunityDuration: 30 * 10,
+    disabledUnits: [],
+    trainerBotName: "Teamstats.PRO",
+  };
+  const start: GameStartInfo = {
+    gameID: g.seed,
+    lobbyCreatedAt: 0,
+    config,
+    players: [],
+  };
+  setTrainerPolicyFor("A", g.a);
+  setTrainerPolicyFor("B", g.b);
+  const terrain = await loadTerrainMap(
+    await loadMapFiles(
+      new PlayDirMapLoader(g.playDir),
+      config.gameMap,
+      config.gameMapSize,
+    ),
+  );
+  const random = new PseudoRandom(simpleHash(g.seed));
+  const nations = createNationsForGame(
+    start,
+    terrain.nations,
+    terrain.additionalNations,
+    0,
+    random,
+  ).map(
+    (n, i) =>
+      new Nation(
+        n.spawnCell === undefined
+          ? undefined
+          : new Cell(n.spawnCell.x, n.spawnCell.y),
+        new PlayerInfo(
+          i === 0 ? "A" : "B",
+          PlayerType.Nation,
+          null,
+          n.playerInfo.id,
+        ),
+      ),
+  );
+  const game = createGame(
+    [],
+    nations,
+    terrain.gameMap,
+    terrain.miniGameMap,
+    new EngineConfig(config, false),
+    terrain.teamGameSpawnAreas,
+  );
+  let error = "";
+  const runner = new GameRunner(
+    game,
+    new Executor(game, g.seed, undefined),
+    (u) => {
+      if ("errMsg" in u) error = u.errMsg;
+    },
+  );
+  runner.init();
+  let turn = 0;
+  const step = () => {
+    runner.addTurn({ turnNumber: turn++, intents: [] });
+    runner.executeNextTick();
+    if (error) throw new Error(error);
+  };
+  while (game.inSpawnPhase()) step();
+  // A nation whose spawn failed lands a few ticks after the spawn phase (NationExecution)
+  const named = (n: string) => game.players().find((p) => p.name() === n);
+  for (
+    let i = 0;
+    i < 50 && (named("A") === undefined || named("B") === undefined);
+    i++
+  )
+    step();
+  const a = named("A");
+  const b = named("B");
+  if (a === undefined || b === undefined)
+    throw new Error("a nation did not spawn");
+  const playStart = game.ticks();
+  const end =
+    playStart + Math.min(config.maxTimerValue! * 600, g.stopAfter ?? Infinity);
+  const share: Record<"A" | "B", number[]> = { A: [], B: [] };
+  const land: Record<"A" | "B", number[]> = { A: [], B: [] };
+  while (game.ticks() < end && a.isAlive() && b.isAlive()) {
+    step();
+    if (game.ticks() % 300 === 0) {
+      for (const [k, p] of [
+        ["A", a],
+        ["B", b],
+      ] as const) {
+        share[k].push(p.troops() / game.config().maxTroops(p));
+      }
+    }
+    if ((game.ticks() - playStart) % 300 === 0) {
+      land.A.push(a.isAlive() ? a.numTilesOwned() : 0);
+      land.B.push(b.isAlive() ? b.numTilesOwned() : 0);
+    }
+  }
+  const avg = (x: number[]) =>
+    x.length
+      ? Math.round((x.reduce((s, v) => s + v, 0) / x.length) * 100) / 100
+      : 0;
+  const tilesA = a.isAlive() ? a.numTilesOwned() : 0;
+  const tilesB = b.isAlive() ? b.numTilesOwned() : 0;
+  const owned = (p: typeof a) => ({
+    city: p.unitsOwned(UnitType.City),
+    port: p.unitsOwned(UnitType.Port),
+    factory: p.unitsOwned(UnitType.Factory),
+    sam: p.unitsOwned(UnitType.SAMLauncher),
+    silo: p.unitsOwned(UnitType.MissileSilo),
+    warship: p.unitsOwned(UnitType.Warship),
+  });
+  return {
+    winner: tilesA > tilesB ? "A" : tilesB > tilesA ? "B" : "draw",
+    tilesA,
+    tilesB,
+    ticks: game.ticks(),
+    ms: Date.now() - t0,
+    units: { A: owned(a), B: owned(b) },
+    troopShare: { A: avg(share.A), B: avg(share.B) },
+    land,
+  };
+}
+
+// teamstats.pro's trainer-learner.js also replays humans' games against changed bots ("ghosts")
+export { replayTrainerGame } from "./ReplayTrainerGame";
